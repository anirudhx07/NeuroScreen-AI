# ML Backend Configuration

# Application Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://neurouser:neuropass@localhost:5432/neuroscreen_ml

# Firebase
FIREBASE_CREDENTIALS=path/to/firebase-credentials.json
